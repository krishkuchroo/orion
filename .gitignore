# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/

# OS
.DS_Store

# Secrets / local env (commit .env.example, never .env)
.env
# eval harness: clean CLAUDE_CONFIG_DIR / CODEX_HOME homes hold copied logins -- never commit
eval/.config/

# Orion run artifacts
.orion/
*.log

# Test fixtures (large / externally sourced)
fixtures/

# Curated scan evidence for reviewers — must survive `git clone`, so never ignore it
# (overrides the *.log rule above for report logs kept under examples/).
!examples/
!examples/**

# Orion-LM training-pair miner: dropped.json is >5 MB (full audit rows; regenerate with
# `python -I train/mine.py build`); raw downloads live outside the repo (orion-lm-research/raw/).
train/data/dropped.json
