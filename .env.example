# Copy to .env and adjust, then load before running:
#   set -a; source .env; set +a
#
# Every value has a sensible localhost default in orion/config.py, so an empty
# .env works out of the box. Override only what you need.

# Neo4j: Orion's own standalone Community instance (see docker-compose.yml).
# The code graph lives here and Orion reads it read-only. Ports match compose (7688 Bolt).
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=orion_dev_changeme
NEO4J_DATABASE=neo4j

# Joern CLI location (joern-parse / joern-export).
JOERN_HOME=~/joern/joern-cli

# Headless "claude -p" settings for discovery and verification.
ORION_MODEL=sonnet
ORION_EFFORT=high
ORION_MAX_TURNS=40
ORION_VERIFY_MAX_TURNS=10
ORION_CALL_TIMEOUT=180

# MCP tool server the agents call (read-only Cypher, semantic search, schema).
ORION_MCP_CONFIG=.mcp/orion.json

# Semantic index backend: "neo4j" (native vector index) or "lancedb" (fallback).
ORION_SEMANTIC_BACKEND=neo4j
ORION_EMBED_MODEL=jinaai/jina-embeddings-v2-base-code
